{
  "openapi": "3.1.0",
  "info": {
    "title": "Store Everything — extractor contract",
    "summary": "The fixed API between the core and an extractor container.",
    "description": "Every call is authenticated with the extractor's own bearer credential (`Authorization: Bearer seext_…`), minted by an administrator and bound to one extractor id. Dispatch is poll-based: the extractor claims work, heartbeats it, and submits one result envelope per job. See specs/05-extractor-contract.md.",
    "version": "v1"
  },
  "paths": {
    "/extractor-api/v1/openapi.json": {
      "get": {
        "tags": [
          "extractor-api"
        ],
        "summary": "The extractor contract",
        "description": "The extractor contract, for the containers that speak it.\n\nBehind the same credential as the rest of this API, for the same reason the user-facing\nschema is authenticated (08): a self-hosted instance publishes nothing it need not. Extractor\nauthors read the copy committed in the repository rather than one served by somebody's box.",
        "operationId": "extractor_openapi_schema",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/extractor-api/v1/registration": {
      "put": {
        "tags": [
          "extractor-api"
        ],
        "summary": "Declare what this extractor can do",
        "operationId": "register_extractor",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Manifest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationAccepted"
                }
              }
            }
          },
          "403": {
            "description": "The manifest declares a different extractor id"
          },
          "409": {
            "description": "Unsupported contract version, or a kind another produces"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/extractor-api/v1/jobs/claim": {
      "post": {
        "tags": [
          "extractor-api"
        ],
        "summary": "Claim the next job",
        "description": "Claim the next job for this extractor, or answer `204` when there is none.\n\nDeliberately not a consumer of the request transaction: waiting has to release its\nconnection between attempts, and a claim has to commit the instant it succeeds — the lease\nit takes is a promise to everybody else, not something to hold open until a response is\nserialised.",
        "operationId": "claim_job",
        "parameters": [
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 30,
              "minimum": 0,
              "default": 0,
              "title": "Wait"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ClaimRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A claimed job, with its fencing token and inputs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimedJobResponse"
                }
              }
            }
          },
          "204": {
            "description": "Nothing is due for this extractor"
          },
          "409": {
            "description": "An administrator has disabled this extractor"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/extractor-api/v1/jobs/{job_id}/heartbeat": {
      "post": {
        "tags": [
          "extractor-api"
        ],
        "summary": "Extend the lease, and learn whether to stop",
        "description": "Extend the lease, and learn whether to stop.\n\nProgress *is* the heartbeat and the heartbeat *is* the cancellation channel (05 § job\nlifecycle): an extractor that keeps reporting keeps its job, and one that is told to stop\nlearns it here rather than from a signal it might miss.",
        "operationId": "heartbeat_job",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Fenced"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such job for this extractor"
          },
          "409": {
            "description": "The lease is no longer this caller's"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/extractor-api/v1/jobs/{job_id}/inputs/{index}": {
      "get": {
        "tags": [
          "extractor-api"
        ],
        "summary": "Read one of a job's inputs",
        "description": "Stream one input of one job — the only bytes this extractor may read.\n\nWhich bytes depends on the version, not on the path: while a version is current its content\nis the file in the workspace, and once it is superseded the app's own copy in `versions/` is\nwhat remains (F-007/FR-9). A version whose bytes are gone from both — overwritten on the\nstorage before the app saw it — is `410`, because there is nothing to analyse and retrying\nwill not change that.",
        "operationId": "read_input",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "title": "Index"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The bytes to analyse",
            "content": {
              "*/*": {}
            }
          },
          "206": {
            "description": "The requested byte range"
          },
          "404": {
            "description": "No such job or input for this extractor"
          },
          "410": {
            "description": "This version's content is no longer stored"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/extractor-api/v1/jobs/{job_id}/assets/{content_hash}": {
      "put": {
        "tags": [
          "extractor-api"
        ],
        "summary": "Stage one derived asset",
        "description": "Upload one derived asset, ahead of the result that references it (05 § dispatch).\n\nTwo phases because a result envelope is a database transaction and a video preview is two\nhundred megabytes: the bytes arrive first, verified against the hash they claim, and the\nenvelope then references them by that hash. Idempotent — re-staging the same bytes for the\nsame job is a no-op, which is what makes a retried upload harmless.\n\nUnfenced, like reading an input: staging writes nothing a later attempt cannot overwrite, and\na worker that has lost its lease is refused when it tries to *submit*. The staged file is\nnamed after the job, so the janitor collects it when the job is gone (12 § debris).",
        "operationId": "stage_asset",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          },
          {
            "name": "content_hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "title": "Content Hash"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StagedAsset"
                }
              }
            }
          },
          "404": {
            "description": "No such job for this extractor"
          },
          "422": {
            "description": "The bytes do not hash to the declared digest"
          }
        }
      }
    },
    "/extractor-api/v1/jobs/{job_id}/result": {
      "post": {
        "tags": [
          "extractor-api"
        ],
        "summary": "Finish a job",
        "description": "Finish a job. One envelope, one guarded transaction, applied once.",
        "operationId": "submit_result",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultEnvelope"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOutcome"
                }
              }
            }
          },
          "404": {
            "description": "No such job for this extractor"
          },
          "409": {
            "description": "A lost lease, or an asset that was never staged"
          },
          "422": {
            "description": "The envelope declared something it could not store"
          }
        }
      }
    },
    "/extractor-api/v1/jobs/{job_id}/error": {
      "post": {
        "tags": [
          "extractor-api"
        ],
        "summary": "Report a failed attempt",
        "description": "Report a failed attempt. The queue decides whether it is retried or dead-lettered.",
        "operationId": "report_error",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobErrorRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOutcome"
                }
              }
            }
          },
          "404": {
            "description": "No such job for this extractor"
          },
          "409": {
            "description": "The lease is no longer this caller's"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssetEntry": {
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Content Hash"
          },
          "media_type": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "title": "Media Type"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "rendition_kind": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Rendition Kind"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "kind",
          "name",
          "content_hash",
          "media_type"
        ],
        "title": "AssetEntry",
        "description": "One staged file, and what it is.\n\n`content_hash` is how it was staged and how the core finds it; `name` is what it will be\ncalled in the derived store. The extractor chooses the name because it knows what the file\nis; the core chooses the directory because it knows where the version's data belongs."
      },
      "ClaimRequest": {
        "properties": {
          "worker": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ClaimRequest"
      },
      "ClaimedJobResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "attempt": {
            "type": "integer",
            "title": "Attempt"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          },
          "extractor_id": {
            "type": "string",
            "title": "Extractor Id"
          },
          "generation": {
            "type": "integer",
            "title": "Generation"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          },
          "lease_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Lease Expires At"
          },
          "heartbeat_interval_seconds": {
            "type": "integer",
            "title": "Heartbeat Interval Seconds"
          },
          "cancel_requested": {
            "type": "boolean",
            "title": "Cancel Requested"
          },
          "file_version": {
            "$ref": "#/components/schemas/JobVersion"
          },
          "inputs": {
            "items": {
              "$ref": "#/components/schemas/InputReference"
            },
            "type": "array",
            "title": "Inputs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "attempt",
          "idempotency_key",
          "extractor_id",
          "generation",
          "params",
          "lease_expires_at",
          "heartbeat_interval_seconds",
          "cancel_requested",
          "file_version",
          "inputs"
        ],
        "title": "ClaimedJobResponse"
      },
      "CostClass": {
        "type": "string",
        "enum": [
          "light",
          "medium",
          "heavy"
        ]
      },
      "Fenced": {
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Attempt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt"
        ],
        "title": "Fenced"
      },
      "GpuMode": {
        "type": "string",
        "enum": [
          "none",
          "optional",
          "required"
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HeartbeatResponse": {
        "properties": {
          "lease_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Lease Expires At"
          },
          "cancel": {
            "type": "boolean",
            "title": "Cancel"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lease_expires_at",
          "cancel"
        ],
        "title": "HeartbeatResponse"
      },
      "InputReference": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "kind": {
            "type": "string",
            "enum": [
              "original",
              "derived"
            ],
            "title": "Kind"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash"
          },
          "digest_algorithm": {
            "type": "string",
            "const": "sha256",
            "title": "Digest Algorithm",
            "default": "sha256"
          },
          "asset": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset"
          },
          "asset_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index",
          "kind",
          "url",
          "media_type",
          "size",
          "content_hash"
        ],
        "title": "InputReference",
        "description": "Where to read one of a job's inputs. Range requests are supported."
      },
      "JobErrorRequest": {
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Attempt"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt",
          "message"
        ],
        "title": "JobErrorRequest"
      },
      "JobOutcome": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "stored": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Stored"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "state",
          "finished_at"
        ],
        "title": "JobOutcome"
      },
      "JobVersion": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash"
          },
          "digest_algorithm": {
            "type": "string",
            "const": "sha256",
            "title": "Digest Algorithm",
            "default": "sha256"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "media_class": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio",
              "document",
              "archive",
              "other"
            ],
            "title": "Media Class"
          },
          "is_current": {
            "type": "boolean",
            "title": "Is Current"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "content_hash",
          "size",
          "media_type",
          "media_class",
          "is_current"
        ],
        "title": "JobVersion"
      },
      "LineAnchor": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "line",
            "title": "Kind",
            "default": "line"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End Line"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "start_line",
          "end_line"
        ],
        "title": "LineAnchor",
        "description": "A line range, for text, markdown and code."
      },
      "Manifest": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Id"
          },
          "version": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Version"
          },
          "api_version": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Api Version"
          },
          "model": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ManifestModelInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "accepts": {
            "$ref": "#/components/schemas/ManifestAccepts"
          },
          "produces": {
            "items": {
              "$ref": "#/components/schemas/OutputKind"
            },
            "type": "array",
            "maxItems": 7,
            "minItems": 1,
            "title": "Produces"
          },
          "renditions": {
            "items": {
              "$ref": "#/components/schemas/ManifestRendition"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Renditions",
            "default": []
          },
          "derived_asset_kinds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Derived Asset Kinds",
            "default": []
          },
          "embedding_spaces": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Embedding Spaces",
            "default": []
          },
          "cost_class": {
            "$ref": "#/components/schemas/CostClass",
            "default": "medium"
          },
          "gpu": {
            "$ref": "#/components/schemas/GpuMode",
            "default": "none"
          },
          "network": {
            "$ref": "#/components/schemas/NetworkMode",
            "default": "none"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "id",
          "version",
          "api_version",
          "produces"
        ],
        "title": "Manifest",
        "description": "What an extractor declares about itself (05 § manifest)."
      },
      "ManifestAccepts": {
        "properties": {
          "mime_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Mime Types",
            "default": []
          },
          "derived_kinds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Derived Kinds",
            "default": []
          },
          "when": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ManifestPredicate"
              },
              {
                "type": "null"
              }
            ]
          },
          "params_from": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "maxProperties": 20,
            "title": "Params From"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "ManifestAccepts",
        "description": "What a job for this extractor may be about."
      },
      "ManifestModelInfo": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "version": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Version"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "title": "ManifestModelInfo",
        "description": "The model an extractor runs, when it runs one.\n\nVersioned because the version is provenance: every row an extractor writes is stamped with\nit, and a bump is what makes files eligible for reprocessing (ADR-0004)."
      },
      "ManifestPredicate": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Key"
          },
          "equals": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Equals"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "key",
          "equals"
        ],
        "title": "ManifestPredicate",
        "description": "`accepts.when` — route here only once a well-known metadata key says so.\n\nHow `pdf-text` hands scanned pages to OCR without either extractor knowing the other\nexists: one writes `needs_ocr`, the other declares it accepts PDFs when that key is true\n(04 § routing). Bound to keys, never to extractor ids."
      },
      "ManifestRendition": {
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Kind"
          },
          "format": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Format"
          },
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Label"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "kind",
          "format",
          "label"
        ],
        "title": "ManifestRendition",
        "description": "One downloadable alternative form of a whole file (ADR-0008)."
      },
      "MetadataEntry": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Key"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "text",
              "integer",
              "float",
              "boolean",
              "datetime",
              "date",
              "duration",
              "geo",
              "json"
            ],
            "title": "Type"
          },
          "value": {
            "title": "Value"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "key",
          "type",
          "value"
        ],
        "title": "MetadataEntry",
        "description": "One typed fact. The type decides both how it is stored and what can be asked of it."
      },
      "NetworkMode": {
        "type": "string",
        "enum": [
          "none",
          "outbound"
        ]
      },
      "OutputKind": {
        "type": "string",
        "enum": [
          "metadata",
          "text_segments",
          "tags",
          "embeddings",
          "derived_assets",
          "renditions",
          "faces"
        ]
      },
      "PageAnchor": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "page",
            "title": "Kind",
            "default": "page"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "char_start": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Char Start"
          },
          "char_end": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Char End"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "page"
        ],
        "title": "PageAnchor",
        "description": "A page, and optionally where on it — the anchor a document hit is rendered from."
      },
      "RegionAnchor": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "region",
            "title": "Kind",
            "default": "region"
          },
          "x": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y"
          },
          "width": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Height"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "RegionAnchor",
        "description": "A rectangle on an image, normalised so it survives every rendition's scaling."
      },
      "RegistrationAccepted": {
        "properties": {
          "extractor_id": {
            "type": "string",
            "title": "Extractor Id"
          },
          "registered_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Registered At"
          },
          "changed": {
            "type": "boolean",
            "title": "Changed"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "manifest": {
            "additionalProperties": true,
            "type": "object",
            "title": "Manifest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "extractor_id",
          "registered_at",
          "changed",
          "enabled",
          "manifest"
        ],
        "title": "RegistrationAccepted"
      },
      "ResultEnvelope": {
        "properties": {
          "metadata": {
            "items": {
              "$ref": "#/components/schemas/MetadataEntry"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Metadata",
            "default": []
          },
          "text_segments": {
            "items": {
              "$ref": "#/components/schemas/SegmentEntry"
            },
            "type": "array",
            "maxItems": 50000,
            "title": "Text Segments",
            "default": []
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagEntry"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Tags",
            "default": []
          },
          "derived_assets": {
            "items": {
              "$ref": "#/components/schemas/AssetEntry"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Derived Assets",
            "default": []
          },
          "attempt": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Attempt"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "attempt"
        ],
        "title": "ResultEnvelope",
        "description": "The result of one job: typed facts, positioned text, generated files.\n\nCarries the claim's `attempt` like every other write-back, so an envelope from a lost lease\nis refused rather than applied. Tags and embeddings are named by the contract but not stored\nby this core version — the committed `openapi-extractor.json` is the authority on which\noutputs a given release accepts."
      },
      "SegmentEntry": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 1,
            "title": "Text"
          },
          "anchor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PageAnchor"
              },
              {
                "$ref": "#/components/schemas/TimeAnchor"
              },
              {
                "$ref": "#/components/schemas/LineAnchor"
              },
              {
                "$ref": "#/components/schemas/SheetAnchor"
              },
              {
                "$ref": "#/components/schemas/RegionAnchor"
              },
              {
                "$ref": "#/components/schemas/WholeAnchor"
              }
            ],
            "title": "Anchor",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "line": "#/components/schemas/LineAnchor",
                "page": "#/components/schemas/PageAnchor",
                "region": "#/components/schemas/RegionAnchor",
                "sheet": "#/components/schemas/SheetAnchor",
                "time": "#/components/schemas/TimeAnchor",
                "whole": "#/components/schemas/WholeAnchor"
              }
            }
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 35,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "text",
          "anchor"
        ],
        "title": "SegmentEntry",
        "description": "A span of text and where it is."
      },
      "SheetAnchor": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "sheet",
            "title": "Kind",
            "default": "sheet"
          },
          "sheet": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Sheet"
          },
          "start_row": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Start Row"
          },
          "end_row": {
            "type": "integer",
            "minimum": 1.0,
            "title": "End Row"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "sheet",
          "start_row",
          "end_row"
        ],
        "title": "SheetAnchor",
        "description": "A sheet and a row range — a better position for a spreadsheet than an invented page."
      },
      "StagedAsset": {
        "properties": {
          "content_hash": {
            "type": "string",
            "title": "Content Hash"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content_hash",
          "size"
        ],
        "title": "StagedAsset"
      },
      "TagEntry": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "TagEntry",
        "description": "One label a machine produced, and how sure it was.\n\nA *name*, not a tag id: a model's vocabulary is not ours, so the core maps the label into\nthe tag vocabulary (ADR-0006) rather than making every extractor learn it. The bounds are\nthe tag-name policy's, so a label that could never be a tag name is refused here — with a\nfield-level problem — instead of failing later on the way into the table."
      },
      "TimeAnchor": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "time",
            "title": "Kind",
            "default": "time"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Ms"
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "End Ms"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "start_ms",
          "end_ms"
        ],
        "title": "TimeAnchor",
        "description": "A span of a recording, in milliseconds — *at 04:12* (F-006)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WholeAnchor": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "whole",
            "title": "Kind",
            "default": "whole"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "WholeAnchor",
        "description": "The whole file — an image's single OCR block, a short note's only segment."
      }
    }
  }
}
