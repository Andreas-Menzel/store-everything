# syntax=docker/dockerfile:1
#
# `tesseract-ocr`, in its own image — the split the shared `Dockerfile` said would happen here.
#
# Every other official extractor's tooling is a wheel, so they share one image and pick an
# entrypoint. OCR is the first that needs system packages: the engine, and a language model per
# language. Putting them in the shared image would add ~50 MB and an apt layer to every container
# on the instance, including the ones that render thumbnails — so this image inherits the shape
# and adds only what OCR needs (05 § built-in extractors).
#
# The language data is **baked in**, not downloaded on first use: this container has no route to
# the internet (ADR-0021), and an extractor that needs one to work would be an extractor that
# never works. `tessdata_fast` is what Debian ships, which is the accuracy/speed trade Tesseract
# itself recommends for 300 dpi input.
#
# Debian **trixie** rather than the bookworm the other images use, on both stages: 05 specifies
# Tesseract 5.5, and bookworm's package is 5.3.0. Pinning the base to the release that carries the
# engine we said we ship is the honest way to keep that promise — the alternative is a spec that
# says 5.5 and an image that quietly does something else.

FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# The same extras as the shared image: OCR needs PDFium to rasterize the pages it reads and
# libvips to write them, and the `documents` stack to know which pages to read at all.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=README.md,target=README.md \
    uv sync --locked --no-install-project --no-dev --extra preview --extra documents

COPY . /app
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra preview --extra documents


FROM python:3.13-slim-trixie AS runtime

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SE_CORE_URL=http://api:8000 \
    # One page at a time, one thread each: parallelism belongs between jobs, where the queue can
    # see it, not inside Tesseract where it competes with the container's CPU limit.
    OMP_THREAD_LIMIT=1

# The engine and the two languages this instance searches in (Q14), plus orientation detection.
# `--no-install-recommends` keeps the X11 and documentation trees that `tesseract-ocr` suggests
# out of an image that will never draw anything.
#
# `upgrade` first, in the same layer: a base image is rebuilt on its own schedule, so it can carry
# packages its own archive has already fixed. This one shipped util-linux 2.41-5 while Debian
# security had 2.41.5-0+deb13u1 — four HIGH CVEs that the image scan rightly refuses. None of them
# is reachable here (they are local-privilege bugs in a SUID `mount` this container has neither the
# capabilities nor the user to run), but taking the fix costs one layer and arguing with a scanner
# costs a standing exception.
RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && apt-get install --yes --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-deu \
        tesseract-ocr-osd \
    && rm -rf /var/lib/apt/lists/*

# Then the same baseline as every other extractor image: no package installer at runtime.
RUN rm -rf /usr/local/lib/python3.*/site-packages/pip \
           /usr/local/lib/python3.*/site-packages/pip-*.dist-info \
           /usr/local/lib/python3.*/ensurepip \
           /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.* \
    && rm -f /usr/bin/apt /usr/bin/apt-get /usr/bin/dpkg

RUN useradd --create-home --uid 10001 extractor

COPY --from=builder --chown=extractor:extractor /app /app

WORKDIR /app
USER extractor

# Nothing listens: dispatch is poll-based (ADR-0020).
CMD ["se-tesseract-ocr"]
