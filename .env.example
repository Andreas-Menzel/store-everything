# Store Everything — deployment configuration.
#
# Copy to `.env` and adjust. `.env` is git-ignored and MUST NOT be committed:
# every value below is deployment config, and some of it is secret
# (10-deployment-and-operations.md § configuration & secrets).

# ---------------------------------------------------------------- core service
# All core-service variables are prefixed `SE_`.

# Required. No default datastore is invented for you.
# Inside the compose stack the host is the postgres service name.
SE_DATABASE_URL=postgresql://store:change-me@postgres:5432/store_everything

# development | production
SE_APP_ENV=production

# DEBUG | INFO | WARNING | ERROR | CRITICAL
SE_LOG_LEVEL=INFO

# Bind address. 0.0.0.0 inside a container; the code's default is loopback.
SE_HOST=0.0.0.0
SE_PORT=8000

# Serve the OpenAPI schema to authenticated users. Never public either way.
SE_API_DOCS_ENABLED=true

# Comma-separated allow-list; empty means deny all cross-origin requests.
# The same-origin web UI needs no entry here.
SE_CORS_ALLOW_ORIGINS=

# Comma-separated proxy addresses whose `X-Forwarded-*` headers are trusted.
# Empty means trust nobody — a spoofed client IP would poison rate limits and
# audit records (ADR-0009). Set this to the reverse proxy's address on the
# shared Docker network, never to a wildcard.
SE_FORWARDED_ALLOW_IPS=

# ---------------------------------------------------------------- postgresql
# Read by the database container. Keep in sync with SE_DATABASE_URL above.

POSTGRES_USER=store
POSTGRES_PASSWORD=change-me
POSTGRES_DB=store_everything
