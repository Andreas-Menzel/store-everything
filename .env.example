# Store Everything — deployment configuration.
#
# Copy to `.env` and adjust. `.env` is git-ignored and MUST NOT be committed:
# every value below is deployment config, and some of it is secret
# (10-deployment-and-operations.md § configuration & secrets).

# ---------------------------------------------------------------- core service
# All core-service variables are prefixed `SE_`.

# Required. No default datastore is invented for you.
# Inside the compose stack the host is the postgres service name.
SE_DATABASE_URL=postgresql://store:change-me@postgres:5432/store_everything

# development | production
SE_APP_ENV=production

# DEBUG | INFO | WARNING | ERROR | CRITICAL
SE_LOG_LEVEL=INFO

# Bind address. 0.0.0.0 inside a container; the code's default is loopback.
SE_HOST=0.0.0.0
SE_PORT=8000

# Serve the OpenAPI schema to authenticated users. Never public either way.
SE_API_DOCS_ENABLED=true

# Comma-separated allow-list; empty means deny all cross-origin requests.
# The same-origin web UI needs no entry here.
SE_CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------- identity
# 07-identity-permissions-sharing.md. Accounts are created by administrators; there is no
# self-registration.

# The first administrator, created at start-up on an instance that has NO accounts yet.
# Ignored once any account exists, so it is not a standing back door — but remove the
# password once you have logged in. The alternative, which keeps the password out of the
# environment entirely:
#   docker compose exec api store-everything create-admin you@example.com
SE_BOOTSTRAP_ADMIN_EMAIL=
SE_BOOTSTRAP_ADMIN_PASSWORD=

# Web sessions expire after this many idle days; using one extends it.
SE_SESSION_IDLE_EXPIRY_DAYS=14

# Keep true in production: it makes the session cookie `Secure` and `__Host-` prefixed.
# Only a plain-HTTP development instance sets it false.
SE_SESSION_COOKIE_SECURE=true

# Failed logins per identity and per client address before further attempts are refused,
# and how long that window lasts.
SE_LOGIN_MAX_ATTEMPTS=10
SE_LOGIN_LOCKOUT_MINUTES=15

# App-level request ceiling per credential (or per address) for /api/v1. Volumetric abuse
# is the proxy's job; this is the backstop.
SE_RATE_LIMIT_PER_MINUTE=300

# ---------------------------------------------------------------- operations
# 12-reliability.md § tuning defaults. Every effectful operation — uploads, scans, moves,
# extraction jobs — is a row in one table, claimed under a lease and retried with backoff.

# A claim owns its work for this long; a worker renews while it works, and an expired lease
# is re-claimable by anyone (that reclaim *is* the crash-recovery path).
SE_LEASE_SECONDS=300
SE_HEARTBEAT_SECONDS=60

# Attempts before an operation is dead-lettered. Counted when work is claimed, not when it
# fails, so a job that kills its worker still converges instead of retrying forever.
SE_MAX_ATTEMPTS=4

# Retry backoff bounds in seconds; the actual delay is jittered between them.
SE_RETRY_BASE_SECONDS=10
SE_RETRY_MAX_SECONDS=3600

# The worker process (`store-everything worker`, the `orchestrator` service).
SE_WORKER_CONCURRENCY=4
SE_WORKER_POLL_SECONDS=5

# ---------------------------------------------------------------- app-owned storage
# 03-storage-and-portability.md § storage layout. Holds `versions/` (superseded file content
# — the only copy, so it is mandatory backup scope) and `derived/` (previews and transcripts,
# regenerable). Mounted as the `app-data` volume in compose.
SE_APP_DATA_ROOT=/var/lib/store-everything

# How long crash debris (staging files, orphaned blobs) is left alone before the janitor
# collects it. The window prevents the janitor racing an operation mid-write.
SE_JANITOR_GRACE_HOURS=24
SE_JANITOR_INTERVAL_MINUTES=60

# ---------------------------------------------------------------- workspace storage
# 03-storage-and-portability.md § storage layout. Distinct from the app-owned area above:
# this holds the user's own files in the user's own folder hierarchy — the data itself, which
# is why it is backup scope and why deleting it is not "losing previews".

# Where `managed` workspace roots are created, one directory per workspace under a directory
# per owner. Mounted as the `workspace-data` volume in compose; point it at a bind mount to
# keep the trees on storage you control.
SE_DATA_ROOT=/srv/store-everything

# How often a workspace is scanned for changes made outside the app — files copied onto the
# NAS by hand, edited in another program, deleted from a share. This is the correctness
# backstop (ADR-0019): a manual rescan is the "look now" button, and the filesystem watcher
# below is the fast path. Stored per workspace at creation, so changing this affects
# workspaces created afterwards.
SE_WORKSPACE_SCAN_INTERVAL_MINUTES=60

# Watch workspace roots for filesystem events, so a file copied onto the storage shows up in
# seconds instead of within the hour. Never load-bearing: an event only hastens a scan the
# schedule would have run anyway, so turning this off costs latency and nothing else.
#
# On Linux each watched directory costs one inotify watch. If a tree is larger than the
# kernel allows (`sysctl fs.inotify.max_user_watches`), the app says so per workspace in
# `import-status` and falls back to the schedule for it — it does not fail. Raise the limit,
# or set this to false.
#
# Kernel events do not fire for changes made on the *server* side of an SMB or NFS mount, so
# on such a mount the watcher subscribes and simply never hears anything. That is the reason
# the scheduled scan is the truth.
SE_WATCHER_ENABLED=true

# How long a burst of filesystem events has to go quiet before it becomes one scan. A copy of
# five hundred files is one intention, not five hundred. A burst that never goes quiet is
# still scanned periodically while it runs.
SE_WATCHER_DEBOUNCE_SECONDS=5

# Comma-separated absolute paths a workspace may be ADOPTED from: an existing directory
# indexed in place, with nothing moved or copied (ADR-0018). Empty — the default — disables
# adoption entirely. Adoption additionally requires an administrator; a member can never
# submit a filesystem path. A listed directory may itself be adopted, as may anything below
# it. Bind-mount the tree into the api and orchestrator containers at the same path first:
#   volumes: ['/mnt/nas/photos:/mnt/nas/photos']
#   SE_ADOPTION_ROOTS=/mnt/nas/photos
# The path is the one *inside* the container, which is the mistake worth double-checking.
SE_ADOPTION_ROOTS=

# ---------------------------------------------------------------- uploads
# ADR-0017. Uploads speak the IETF resumable-upload protocol; these three sizes are published
# to clients in the `Upload-Limit` header, so a proxy's body limit is a negotiated number
# rather than a mystery failure halfway through a large file.

# How long an interrupted upload can be resumed. Its staged bytes live in the workspace's
# own `.workspace/staging/` area until then, and the janitor collects them afterwards.
SE_UPLOAD_EXPIRY_DAYS=7

# Largest single upload in bytes. 0 means no app-level limit — the storage is the limit —
# and omits `max-size` from Upload-Limit rather than publishing a number that is not true.
SE_UPLOAD_MAX_SIZE=0

# Largest body one request may carry (64 MiB). This also caps a *one-shot* upload: anything
# bigger must use the resumable flow, which every client of ours does. Keep it comfortably
# below the proxy's own body and timeout limits.
SE_UPLOAD_MAX_APPEND_SIZE=67108864

# Smallest body an append should carry (1 MiB) — and the line the request ceiling uses. An
# append at least this large is not counted against SE_RATE_LIMIT_PER_MINUTE, because what
# that ceiling rations is per-request overhead rather than throughput: a fast link uploading
# a large file would otherwise rate-limit itself, while an attacker sending kilobyte appends
# still spends the ordinary budget.
SE_UPLOAD_MIN_APPEND_SIZE=1048576

# ---------------------------------------------------------------- deployment
# Read by docker compose. Only the API is attached to the proxy's network; everything
# else stays internal with no ingress (ADR-0009).

# The hostname Traefik routes to this instance.
PUBLIC_HOST=cloud.example.com

# The existing Traefik instance's shared Docker network, and its router settings.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# The proxy's address on that network. Empty means no X-Forwarded-* header is believed,
# which is the safe default: a spoofed client IP poisons rate limits and audit records.
# Find it with: docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' <traefik-container>
SE_FORWARDED_ALLOW_IPS=

# Published image. Leave unset to build locally with `docker compose build`.
# IMAGE=ghcr.io/andreas-menzel/store-everything-core:v0.1.0

# Development override only (compose.dev.yaml): ports published on localhost.
API_PORT=8000
POSTGRES_PORT=5432

# ---------------------------------------------------------------- postgresql
# Read by the database container. Keep in sync with SE_DATABASE_URL above.

POSTGRES_USER=store
POSTGRES_PASSWORD=change-me
POSTGRES_DB=store_everything
